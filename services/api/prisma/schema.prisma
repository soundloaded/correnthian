// Correnthian data model.
//
// ---------------------------------------------------------------------------
// SECURITY INVARIANT — read before adding a field.
//
// This schema MUST NOT acquire a column capable of holding a seed phrase,
// private key, signing share, or any other material that could move user
// funds. Correnthian's security model is that the user's keys never reach our
// infrastructure. That property is only as strong as this file.
//
// A `Wallet` here is a *registered public address*. It is a watch-list entry
// that lets us index a portfolio and attribute activity. It is not a custody
// record. If you find yourself wanting to add a key field, you are about to
// convert Correnthian from a non-custodial wallet into a custodian, with the
// licensing, insurance and breach consequences that follow.
//
// Security baseline: OWASP MASVS / MASTG.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ChainFamily {
  evm
  bitcoin
  solana
}

enum AccountKind {
  smart
  seed
}

enum UserRole {
  user
  support
  compliance
  admin
  owner
}

/// What a one-time auth link grants. Magic links open a session; password
/// resets grant the right to set a new password. Same shape, same discipline
/// — see the migration header.
enum AuthTokenPurpose {
  magic_link
  password_reset
}

enum DevicePlatform {
  ios
  android
  web
}

enum KycStatus {
  not_started
  pending
  approved
  rejected
  expired
}

enum AssetCategory {
  crypto
  stablecoin
  metal
  treasury
  fund
  other
}

enum TokenStandard {
  native
  erc20
  bep20
  btrc20
  spl
  other
}

/// How the issuer holds the underlying on its side.
enum CustodyModel {
  /// One-for-one against identified, serialised physical metal.
  allocated
  /// Backed in aggregate. No specific asset is reserved for the holder.
  unallocated
  /// No backing at all. Price exposure only.
  synthetic
}

enum VerifiedTier {
  issuer_verified
  community_verified
  unverified
}

enum AttestationCadence {
  monthly
  quarterly
  annual
  none
}

enum RailKind {
  /// Licensed metals / RWA provider. Primary rail.
  provider
  /// DEX aggregator. Secondary rail, carries a size cap.
  dex
  /// Reserved. Weakens the key boundary; unlikely to ship.
  cex
  otc
}

enum ProviderStatus {
  active
  degraded
  disabled
}

enum ProviderCategory {
  metals
  onramp
  offramp
  rpc
  pricing
  kyc
  sanctions
  indexer
}

enum QuoteState {
  quoted
  awaiting_payment
  broadcast
  settled
  failed
  expired
}

enum ExecutionQuality {
  deep
  thin
  none
}

/// The transaction lifecycle — a state machine, not a status flag.
///
/// §62 of the plan: financial operations are not `success: true`. They are
/// explicit states, because recovery and reconciliation are only safe if the
/// system can say *where* a record stopped rather than whether it stopped.
///
/// `dropped` is deliberately NOT a state. A dropped transaction is a fact
/// about the network — it was broadcast and has not been mined — so it is
/// expressed as `droppedAt`/`dropCount` on a row that is still `pending` or
/// `broadcast`. Encoding it as a state would strand the transaction: it would
/// have nowhere to go when the network accepts it again.
enum TxLifecycle {
  /// Recorded. Nothing has been signed and nothing exists on the network.
  created
  /// The account holder's device reports it signed. Correnthian did not sign
  /// and cannot verify this; see docs/architecture/key-boundary.md.
  signed
  /// A hash exists and the transaction is on the network.
  broadcast
  /// Seen on the network, not yet at the required confirmation depth.
  pending
  /// At or past the required confirmation depth.
  confirmed
  failed
  /// Withdrawn by the owner before anything reached the network.
  cancelled
  /// An unsigned intent that was never acted on and timed out.
  expired
}

enum TxDirection {
  in
  out
  internal
}

enum RedemptionState {
  requested
  kyc_pending
  approved
  in_production
  shipped
  delivered
  rejected
  cancelled
}

enum AuditOutcome {
  success
  failure
  denied
}

/// Lifecycle of an idempotency claim. See src/common/idempotency.
enum IdempotencyState {
  /// The claim is held and the handler is running. Exactly one request can be
  /// in this state per key.
  in_progress
  /// The handler returned; the response is stored and will be replayed.
  completed
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id     String   @id @default(cuid())
  email  String   @unique
  role   UserRole @default(user)
  status String   @default("active")

  displayName String?
  country     String? @db.Char(2)
  /// Free-form subdivision, e.g. "US-CA". Jurisdiction engine reads this.
  region      String?

  /// Argon2id digest of the account password. Nullable: accounts
  /// authenticated by magic link have none, which is the target UX for the
  /// beachhead user who should never have to choose a password.
  passwordDigest String?

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  kycStatus KycStatus   @default(not_started)
  kyc       KycProfile?

  sessions Session[]
  devices  Device[]
  wallets  Wallet[]
  /// One-time links for passwordless sign-in and password reset. Cascaded:
  /// deleting the account must not leave a live link behind.
  authTokens AuthToken[]
  /// Denormalised from `Wallet`, never taken from a request body. Listed here
  /// so "everything this account moved" does not need a join through Wallet.
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([kycStatus])
  @@index([country, region])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the session token. The token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A one-time link for passwordless sign-in or password reset — BE-203.
///
/// The raw token is handed to the account holder once (in the email) and is
/// otherwise known to nobody, including us: only its SHA-256 is stored, as
/// with sessions. Use marks the row consumed; expiry is a column, not a
/// hope. A used, expired, or unknown token is indistinguishable from the
/// outside, because distinguishing them confirms whether an address is
/// registered.
model AuthToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose AuthTokenPurpose

  /// SHA-256 of the token. The token itself is never stored.
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

model Device {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform  DevicePlatform
  label     String
  /// Device-bound public key for a smart-account passkey signer.
  /// Public key only — never a private key.
  publicKey String?
  pushToken String?

  trustedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model KycProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       KycStatus @default(not_started)
  /// Opaque reference to the KYC vendor's record. We store a pointer,
  /// never identity documents or biometric data.
  providerRef  String?
  provider     String?
  jurisdiction String?

  reviewedBy String?
  reviewedAt DateTime?

  /// Watchlist screening outcome. Null means never screened. A `hit` latches:
  /// only a human decision clears it — a later clean screen records but does
  /// not unfreeze, because list matching jitters and jitter must not decide
  /// who can buy gold. See BE-1105.
  sanctionsResult SanctionsResult?
  /// When the recorded `sanctionsResult` was produced. The fiat gate treats
  /// a clean result as valid for 24h, then re-screens inline.
  sanctionsScreenedAt DateTime?

  /// Raised when a webhook verdict is anything but a clean pass, or when a
  /// sanctions screen hits. The review queue is exactly the profiles with
  /// this set. Cleared only by an operator decision.
  needsReview Boolean @default(false)
  /// Persona timestamp of the last decision event applied. Webhook events
  /// older than this are stale replays: acknowledged, never applied.
  lastDecisionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([needsReview])
}

/// Outcome of a sanctions/watchlist screen. Kept as its own enum so a
/// widening (e.g. distinguishing PEP from sanctions) is a schema change
/// reviewed on purpose, not a string somebody typed.
enum SanctionsResult {
  clean
  hit
}

/**
 * One processed third-party event, by provider and event id.
 *
 * Webhooks retry. "Approved then approved again" must not double-write, so
 * the pair is unique and a repeat is acknowledged without applying. This is
 * deliberately separate from `IdempotencyRecord`: that table is client keys
 * with leases and replayable responses, and bending it to hold vendor event
 * ids would mix two trust domains in one uniqueness constraint.
 */
model WebhookEvent {
  id String @id @default(cuid())

  provider String
  eventId  String

  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
}

// ---------------------------------------------------------------------------
// Wallets — public addresses only. See the invariant at the top of this file.
// ---------------------------------------------------------------------------

model Wallet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Registered public address. Lower-cased for EVM. Never a secret.
  address  String
  chainId  String
  chain    Chain       @relation(fields: [chainId], references: [id])
  kind     AccountKind
  label    String?
  /// ERC-4337 smart accounts are not on-chain until first funded.
  deployed Boolean     @default(false)

  /// Guardian addresses for social recovery. Public addresses.
  guardians String[] @default([])

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     WalletAccount[]
  transactions Transaction[]
  snapshots    PortfolioSnapshot[]

  @@unique([chainId, address])
  @@index([userId])
  @@index([chainId])
}

model WalletAccount {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id])
  /// Balance in the asset's base units, as a string. Never a float.
  balanceRaw   String    @default("0")
  /// Denormalised USD value for fast portfolio reads.
  balanceUsd   Decimal?  @db.Decimal(36, 18)
  lastSyncedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([walletId, assetId])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Registry — assets, issuers, chains
// ---------------------------------------------------------------------------

model Issuer {
  id           String @id @default(cuid())
  slug         String @unique
  name         String
  jurisdiction String

  /// e.g. ["trust-company", "bank", "fintech", "unknown"]
  licenseTypes String[] @default([])
  licenseRefs  String[] @default([])
  website      String?

  /// Operational trust assessment, maintained by the compliance team.
  verifiedTier VerifiedTier @default(unverified)
  riskFlags    String[]     @default([])
  notes        String?

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verifiedTier])
}

model Asset {
  id String @id @default(cuid())

  /// Derived identity: `${chainId}:${contract|lower|native}:${issuerId}`.
  /// Enforced in application code by `deriveAssetId()`.
  assetId String @unique

  chainId         String
  chain           Chain         @relation(fields: [chainId], references: [id])
  /// Empty string means a native asset, which has no contract. Not nullable:
  /// Postgres treats NULLs as distinct in a unique index, so a nullable column
  /// here would let duplicate native assets for one chain and issuer through.
  contractAddress String        @default("")
  tokenStandard   TokenStandard @default(erc20)
  symbol          String
  name            String
  decimals        Int
  category        AssetCategory

  issuerId String
  issuer   Issuer @relation(fields: [issuerId], references: [id])

  // --- Backing: the provenance payload. This is the product. ---
  custodyModel       CustodyModel       @default(synthetic)
  custodian          String?
  vaultLocations     String[]           @default([])
  proofOfReserveUrl  String?
  attestationCadence AttestationCadence @default(none)
  lastAttestedAt     DateTime?
  gramsPerToken      Decimal?           @db.Decimal(18, 7)
  ouncesPerToken     Decimal?           @db.Decimal(18, 8)

  // --- Trading ---
  transferSupported Boolean    @default(true)
  swapSupported     Boolean    @default(false)
  redeemSupported   Boolean    @default(false)
  rails             RailKind[] @default([])

  // --- Trust ---
  verifiedTier VerifiedTier @default(unverified)
  riskFlags    String[]     @default([])

  // --- Display ---
  iconUrl     String?
  accentColor String?

  enabled Boolean @default(true)

  accounts     WalletAccount[]
  quotesAsFrom SwapQuote[]         @relation("QuoteFromAsset")
  quotesAsTo   SwapQuote[]         @relation("QuoteToAsset")
  transactions Transaction[]
  prices       AssetPrice[]
  redemptions  RedemptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, contractAddress, issuerId])
  @@index([category, enabled])
  @@index([symbol])
}

model Chain {
  id           String      @id
  name         String
  family       ChainFamily
  nativeSymbol String
  decimals     Int         @default(18)

  rpcUrls     String[] @default([])
  explorerUrl String?
  /// Base units of native currency per USD, kept current by the pricing job.
  /// Nullable because a newly configured chain has no price yet.
  gasPriceUsd Decimal? @db.Decimal(36, 18)

  enabled   Boolean @default(false)
  /// EVM only. Non-EVM chains use a distinct adapter.
  isTestnet Boolean @default(false)

  assets       Asset[]
  wallets      Wallet[]
  transactions Transaction[]
  quotes       SwapQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([family])
  @@index([enabled])
}

// ---------------------------------------------------------------------------
// Providers and rails
// ---------------------------------------------------------------------------

model Provider {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  category ProviderCategory

  status        ProviderStatus @default(disabled)
  /// Arbitrary health payload from the last probe. Never credentials.
  lastHealth    Json?
  lastCheckedAt DateTime?

  /// Capabilities this provider advertises, e.g. ["buy","sell","quote"].
  capabilities String[] @default([])

  notes String?

  quotes      SwapQuote[]
  redemptions RedemptionRequest[]
  /// Only populated for a transaction a provider actually settled. A
  /// self-custodial send has no provider, and must not be given one.
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, status])
}

model SwapQuote {
  id String @id @default(cuid())

  userId   String?
  walletId String?

  railKind RailKind
  /// SwapRail implementation id, e.g. "provider-rails" or "dex-aggregator".
  railId   String

  fromAssetId String
  fromAsset   Asset     @relation("QuoteFromAsset", fields: [fromAssetId], references: [id])
  toAssetId   String
  toAsset     Asset     @relation("QuoteToAsset", fields: [toAssetId], references: [id])
  chainId     String
  chain       Chain     @relation(fields: [chainId], references: [id])
  providerId  String?
  provider    Provider? @relation(fields: [providerId], references: [id])

  fromAmountRaw String
  toAmountRaw   String
  notionalUsd   Decimal? @db.Decimal(36, 8)

  priceImpactBps Int
  slippageBps    Int
  minReceivedRaw String

  /// Itemised and shown to the user before signing. Correnthian never
  /// earns by mispricing an asset — the fee is always a visible line.
  fees Json @default("[]")

  /// How honestly this quote can be filled. Forces the UI to disclose.
  executionQuality ExecutionQuality @default(thin)
  /// Largest notional fillable at this price, in USD. Null = uncapped.
  sizeCapUsd       Decimal?         @db.Decimal(36, 2)

  state  QuoteState @default(quoted)
  txHash String?

  expiresAt DateTime
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, state])
  @@index([state, expiresAt])
  @@index([fromAssetId, toAssetId])
}

// ---------------------------------------------------------------------------
// Activity
// ---------------------------------------------------------------------------

/// A record of intended or completed chain activity.
///
/// TWO INVARIANTS, both enforced by `TransactionService` and asserted in
/// `transactions/key-boundary.spec.ts`:
///
///  1. This row is never a custody record and must never gain a column that
///     could hold key material. See the schema header and
///     `docs/architecture/key-boundary.md`.
///  2. There is deliberately NO column for a signed payload. A signed
///     transaction is a replayable authorisation while its nonce is unspent,
///     and `redactDeep()` cannot catch one — it is not shaped like a secret.
///     Storing it here would make this table the best target in the system.
model Transaction {
  id String @id @default(cuid())

  /// Denormalised from `Wallet` on create and never accepted from a request.
  /// A caller must not be able to file activity against another account.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])
  chainId String
  chain   Chain  @relation(fields: [chainId], references: [id])

  /// §21 "Provider". Null for a self-custodial send — nobody at Correnthian
  /// is in the middle of it, and inventing a provider would misrepresent one.
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  /// Public address the value is going to. A mistyped destination is an
  /// irreversible loss, so it is validated against the chain family before
  /// the row is written. Never a key.
  destination String?

  /// Null until BROADCAST — an unsigned intent has no hash. Postgres treats
  /// NULLs as distinct in a unique index, so many intents per chain coexist
  /// while at most one row per chain can ever claim a given hash.
  txHash    String?
  direction TxDirection @default(out)

  /// The lifecycle. See `TxLifecycle` and `src/transactions/transaction-lifecycle.ts`
  /// for the transitions that are allowed. The table there is the only place
  /// that knows them.
  state TxLifecycle @default(created)

  amountRaw String
  amountUsd Decimal? @db.Decimal(36, 8)
  /// §21 "Fee". Base units, as a string — never a float.
  feeRaw   String?
  feeUsd   Decimal? @db.Decimal(36, 8)

  blockNumber   BigInt?
  confirmations Int      @default(0)
  /// Depth at which this is treated as final. Set at creation from the chain
  /// family; a caller may raise it for a large value.
  requiredConfirmations Int @default(1)

  /// A drop is a fact about the network, not a lifecycle state: the
  /// transaction was broadcast and has not been mined. Tracking it as columns
  /// means the row can still move forward when the network accepts it again.
  droppedAt  DateTime?
  dropCount  Int       @default(0)
  /// When the chain was last observed to hold this transaction. A stale value
  /// is how a drop gets noticed.
  lastSeenAt DateTime?

  /// Arbitrary chain data.
  metadata Json?

  /// §21 "Error information". Set when `state = failed`.
  errorCode    String?
  errorMessage String?

  /// An unsigned intent expires rather than sitting in `created` forever.
  expiresAt DateTime?
  signedAt  DateTime?
  /// Broadcast time, or the last re-broadcast after a drop.
  broadcastAt DateTime?
  confirmedAt DateTime?
  failedAt    DateTime?
  blockTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, txHash])
  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([state])
  @@index([chainId, state])
}

model PortfolioSnapshot {
  id String @id @default(cuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  totalUsd  Decimal @db.Decimal(36, 8)
  breakdown Json    @default("{}")

  capturedAt DateTime @default(now())

  @@index([walletId, capturedAt])
}

model AssetPrice {
  id String @id @default(cuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  priceUsd Decimal @db.Decimal(36, 8)
  source   String

  capturedAt DateTime @default(now())

  @@index([assetId, capturedAt])
  @@index([source, capturedAt])
}

// ---------------------------------------------------------------------------
// Metals-specific
// ---------------------------------------------------------------------------

model RedemptionRequest {
  id String @id @default(cuid())

  userId     String
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  state RedemptionState @default(requested)

  /// Who approved this redemption, for the transitions that are a human
  /// determination. Nullable: `requested` and the shipment states have no
  /// reviewer, and a column that pretended otherwise would be a lie.
  ///
  /// A user id only. Nothing here may ever hold key material — see the
  /// invariant at the top of this file.
  reviewedBy String?

  amountRaw   String
  notionalUsd Decimal? @db.Decimal(36, 8)
  feesUsd     Decimal? @db.Decimal(36, 8)

  /// Serialised units where the provider supports per-bar redemption.
  serialNumbers String[] @default([])

  destination Json?

  providerRef     String?
  rejectionReason String?

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, state])
  @@index([providerId, state])
}

// ---------------------------------------------------------------------------
// Compliance and operations
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Fees (§37)
// ---------------------------------------------------------------------------

/// The operation a fee applies to. §37's redemption / on-ramp / off-ramp
/// categories live here rather than in `FeeKind`, because they answer "which
/// operation", not "who is paid".
enum FeeOperation {
  swap
  buy
  sell
  redeem
  onramp
  offramp
}

/// Who is paid. Three categories, not seven: the other four in §37's list are
/// operation-specific, and flattening the two axes would make a redemption fee
/// inexpressible as a provider fee. See `src/fees/fee-rule.ts`.
enum FeeKind {
  network
  provider
  correnthian
}

/// How a rule turns a notional into an amount.
enum FeeBasis {
  percent
  fixed
  /// A named, visible margin. Never folded into a price — that is the whole
  /// reason it is modelled as its own basis rather than as a percentage.
  spread
}

/// Mirrors `AssetCategory`. Postgres will not let one enum type answer to two
/// names, so the two must be kept in step when a category is added.
enum FeeAssetCategory {
  crypto
  stablecoin
  metal
  treasury
  fund
  other
}

/// A fee, as data.
///
/// Changing a number here must not require a deploy: a fee is a commercial
/// term, and it changes because counsel read a contract or a promotion ended.
/// Both are business events.
///
/// There is deliberately no column for an adjusted price. Correnthian never
/// earns by mispricing an asset, and a fee is always a named line on a
/// breakdown — see the security note in the migration.
model FeeRule {
  id String @id @default(cuid())

  operation FeeOperation
  kind      FeeKind
  basis     FeeBasis

  /// The customer's line item, verbatim. Never generated from the selectors.
  label String

  /// An INTEGER count of basis points for `percent` and `spread`. 1.49% is
  /// 149, not `0.0149` — a float rate is not exactly representable, and the
  /// error compounds across every quote. One basis point is the finest rate
  /// this model can express, which is deliberate.
  rateBps Int?

  /// An exact amount for `fixed`, at the same 10^-8 scale as
  /// `SwapQuote.notionalUsd` so the two round consistently against each other.
  fixedUsd Decimal? @db.Decimal(36, 8)

  // --- Selectors. Every one optional; NULL means "not restricted to".
  // A rule that names nothing applies everywhere, which is the normal case.

  assetId       String?
  assetCategory FeeAssetCategory?

  /// A `Provider.slug`. NULL is "any provider, or none".
  providerSlug String?

  /// ISO-3166 alpha-2. NULL is any country.
  country String? @db.Char(2)
  /// NULL is "the whole country". Nullable unlike `JurisdictionRule.region`,
  /// which needs a non-null column to target a compound unique for upsert.
  region String?

  /// Inclusive at both ends.
  minNotionalUsd Decimal? @db.Decimal(36, 8)
  maxNotionalUsd Decimal? @db.Decimal(36, 8)

  /// Higher wins among rules of the same operation and kind. The explicit
  /// operator-set tie-break, and the only way to separate two rules that are
  /// each more specific in a different direction — "most specific wins" cannot
  /// rank those, so the resolver refuses them instead of guessing.
  priority Int @default(0)

  /// Exclusive at the end: a rule stops applying at that instant.
  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  /// An inactive rule is not a rule. It is not a fee of zero, and it must not
  /// become one on the way to resolution.
  active Boolean @default(true)

  /// Who set the rate. Not a relation: the audit trail already records the
  /// operator, and a dangling id is better than a cascade that erases the
  /// attribution when an account is removed.
  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operation, kind, active])
  @@index([active])
}

model JurisdictionRule {
  id String @id @default(cuid())

  country String @db.Char(2)
  /// Empty string means "applies to the whole country". Not nullable: Prisma
  /// cannot target a nullable column in a compound unique selector, which
  /// makes (country, region) unusable for upsert and findUnique.
  region  String @default("")

  canBuyCrypto  Boolean @default(false)
  canSellCrypto Boolean @default(false)
  canUseMetals  Boolean @default(false)
  canRedeem     Boolean @default(false)
  kycRequired   Boolean @default(true)

  /// Provider slugs explicitly blocked in this jurisdiction.
  blockedProviders String[] @default([])
  notes            String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, region])
  @@index([active])
}

/// Append-only. Nothing in the application updates or deletes a row here.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  outcome    AuditOutcome @default(success)

  /// §55 `before`/`after` — the state of the resource either side of a
  /// state-changing operation, not a free-form blob. Null on a create (there
  /// was nothing before) and on a delete (there is nothing after).
  ///
  /// Both are redacted on the way in with `redactDeep()`, exactly like
  /// `metadata`: a snapshot of a whole row is the largest surface in the
  /// system for a field nobody meant to copy.
  before Json?
  after  Json?

  /// §55 `reason` — why the operator did it. "Provider outage" is the whole
  /// value of the record; without it an audit line says what happened and
  /// nothing about why, which is the half an investigation needs.
  ///
  /// Enforced, not merely documented: `AuditService.recordChange` refuses a
  /// destructive operation that arrives without one, and `DESTRUCTIVE_ACTIONS`
  /// is the list it refuses against.
  reason String?

  ipAddress String?
  /// The device the request identified itself with, when it did.
  deviceId  String?
  /// Correlates this entry with the log lines of the request that wrote it.
  /// Threaded automatically from the request by `AuditContextMiddleware`, so
  /// a service never has to remember to pass it.
  requestId String?

  /// Metadata only. Redacted before write; must never contain secrets.
  metadata  Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
}

model Notification {
  id String @id @default(cuid())

  userId   String
  channel  String
  template String

  /// Rendered content, or null for a templated notification.
  payload Json @default("{}")

  sentAt   DateTime?
  failedAt DateTime?
  error    String?

  /// The delivery lease: who holds the row, and when the hold lapses.
  /// A worker that dies mid-batch leaves these set; the next worker treats
  /// a lapsed lease as unclaimed. See `DEF-009` and the migration header.
  claimedBy    String?
  claimedUntil DateTime?

  createdAt DateTime @default(now())

  deliveries DeliveryLog[]

  @@index([userId, createdAt])
  @@index([channel, sentAt])
  @@index([claimedUntil])
}

/// One attempt to deliver a notification through a transport.
///
/// The `Notification` row is the intent; this table is the record of what
/// the transport did with it. A row that claims to have been emailed is a
/// lie a user could act on, so every attempt is written down — sent,
/// failed, and retried alike — and the *latest* attempt is what the state is.
model DeliveryLog {
  id             String @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel  String @default("email")
  template String
  userId   String

  /// Which attempt this was. The first delivery of a row is 1.
  attempt Int @default(1)

  /// `sent`, `failed` or `retrying`. `failed` is terminal; `retrying` means
  /// the row is back in the queue with a fresh lease.
  status String

  providerMsgId String?
  error         String?

  createdAt DateTime @default(now())

  @@index([notificationId])
  @@index([status, createdAt])
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  /// Percentage 0-100 for gradual rollout.
  rollout     Int     @default(100)
  description String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// System settings
// ---------------------------------------------------------------------------

/// An operator's override for a setting the code declares.
///
/// This table holds **overrides only**. The value of every setting is decided
/// in code — `services/api/src/settings/registry.ts` names each key, its type,
/// its bounds and its default — and this table records only where an operator
/// has replaced that default. The effective value is `override ?? default`.
///
/// That split is the whole point. A row here is never the definition of a
/// setting, so a key cannot be read by nothing: it is in the registry, and a
/// test fails the build if a registry key is never read outside it. It is also
/// why the column is `Json` and not one column per setting — a new setting is
/// a code change, not a migration, and it cannot be added by writing a row.
///
/// `Json` enforces nothing, so the value is validated against its key's
/// schema on the way in and on the way out. A stored value that a later code
/// change made invalid falls back to the declared default rather than
/// wedging the platform.
///
/// SECURITY INVARIANT: this table holds configuration, never key material.
/// Nothing that could move user funds may be written here.
model SystemSetting {
  key String @id

  /// The override value. Validated against the key's declared schema.
  value Json

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

/// A claim on an `Idempotency-Key`, and the response that claim produced.
///
/// This table is the answer to "the user pressed Buy twice because the network
/// is slow". It is in Postgres, not Redis, on purpose: Redis is a cache, it is
/// routinely flushed or evicted under memory pressure, and an idempotency
/// store that forgets is worse than none at all — the retry it was supposed to
/// absorb re-executes, and the user gets two purchases. Losing this table must
/// never be possible by losing a cache entry.
///
/// The unique constraint on `keyHash` is what serialises concurrent duplicates
/// across API instances. `INSERT ... ON CONFLICT DO NOTHING` against a unique
/// index takes a row lock, so exactly one of N simultaneous requests wins the
/// insert and the rest are told to wait. An in-process mutex cannot do this:
/// with two API replicas the second replica's mutex is a different mutex, and
/// both requests execute.
model IdempotencyRecord {
  id String @id @default(cuid())

  /// SHA-256 of "<actor id>" + newline + "<the client's key>".
  ///
  /// The key itself is never persisted, not even in a reversible form. A key
  /// is client-supplied and opaque, and "we only keep the hash" is the same
  /// argument that lets someone paste a live key into a log: the safest place
  /// for a value nobody needs in plaintext is nowhere at all. Hashing also
  /// makes a database dump useless for replaying a request against this API.
  keyHash String @unique

  /// SHA-256 of "<METHOD>" + newline + "<path>" + newline + "<canonical body>".
  /// The body is hashed, not stored: the fingerprint has to prove "same
  /// request", and it has no reason to hold a copy of the request.
  requestHash String

  method String
  path   String

  state IdempotencyState @default(in_progress)

  /// The response to replay, and the status to replay it with. Both are
  /// required for a replay to be indistinguishable from the original.
  responseStatus Int?
  responseBody   Json?

  /// How long the executing instance holds the claim.
  ///
  /// A lease, not a timeout for the key. It distinguishes "another instance is
  /// running this right now" (wait for it) from "the instance that was running
  /// it died" (do not re-execute — the outcome is unknown, and a blind retry
  /// could be the second purchase this mechanism exists to prevent).
  lockedUntil DateTime

  /// When a completed record stops being replayable and the key becomes free.
  expiresAt DateTime

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([expiresAt])
  @@index([state, expiresAt])
}

// ---------------------------------------------------------------------------
// Scheduled jobs
//
// §7 (queues/events) and §33 (provider health). Nothing in this system ran on
// a schedule before this, which left several things built but never executed
// and several that would silently rot.
//
// The split this section encodes: **the schedule lives in Redis, the record
// lives here.** A lease is ephemeral by nature, and losing one costs a single
// duplicate run of a job that is deliberately re-runnable. The *record* is
// what an operator reads at 3am to answer "did the purge run last night", and
// that answer has to survive a Redis flush and a failover.
// ---------------------------------------------------------------------------

/// How one execution of a scheduled job ended.
///
/// `running` is the state a row is left in when the instance holding the job
/// died mid-run. A healthy run passes through it for as long as it takes, so
/// the state is not itself a fault — a `running` row older than the job's own
/// interval is. The next instance to take the job marks it `abandoned`,
/// because a dead process cannot write its own epitaph.
enum JobRunOutcome {
  running
  succeeded
  failed
  abandoned
}

/// One execution of one scheduled job.
model JobRun {
  id String @id @default(cuid())

  /// Stable job identity, e.g. `idempotency.purge`.
  ///
  /// A name, not a foreign key. A job deleted from the code must not take its
  /// history with it: "this job has not run since the deploy that removed it"
  /// is a thing an operator needs to be able to see.
  jobName    String
  /// Which replica ran it. With more than one instance this is the first
  /// question asked about a run that behaved strangely, and the answer is not
  /// recoverable from anywhere else.
  instanceId String

  /// `schedule` or `manual`. An operator-triggered run and an automatic one
  /// are different events even when they execute identical code.
  trigger String @default("schedule")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Wall-clock duration of the run. Null while it is still going.
  durationMs Int?

  outcome JobRunOutcome @default(running)

  /// Rows the run changed — deleted, transitioned, flagged.
  ///
  /// The one number that answers "is this job still doing anything", and the
  /// first sign that a filter has quietly stopped matching. A job reporting
  /// `succeeded, affected: 0` forever is a job that is running and useless.
  affected Int @default(0)

  /// Job-specific detail: batch counts, which assets are stale, why a sweep
  /// stopped early. Redacted before it is written — a job's detail is derived
  /// from provider and chain state, which is exactly the kind of payload that
  /// grows an endpoint or a credential by accident.
  detail Json?

  /// The failure, truncated and redacted. Never a stack, and never anything a
  /// provider said verbatim.
  error String?

  @@index([jobName, startedAt])
  @@index([startedAt])
  @@index([outcome, startedAt])
}
