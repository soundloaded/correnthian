# ---------------------------------------------------------------------------
# Correnthian environment
#
# GOLDEN RULE: this file contains Correnthian's own secrets only. No user
# seed phrase, private key or signing material ever belongs here or in any
# variable in this file. If something is added that could move user funds,
# it belongs in the user's device, not in this repository's environment.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=correnthian
POSTGRES_PASSWORD=
POSTGRES_DB=correnthian
POSTGRES_PORT=5433
# Local development comes from Docker: `pnpm db:up`.
# Host port 5432 is occupied by another project, so Correnthian binds 5433.
DATABASE_URL=postgresql://correnthian:correnthian_dev@localhost:5433/correnthian

# --- Cache / queues ---
REDIS_URL=redis://localhost:6380

# --- API ---
# Validated by @correnthian/config at boot. The process will not start
# without a valid DATABASE_URL and REDIS_URL.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001
# Enable only when running behind a TLS-terminating proxy.
TRUST_PROXY=false
LOG_LEVEL=info
LOG_PRETTY=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# The /auth/* budget. Kept separate from MAX_REQUESTS so raising one does not
# raise the other — this is the ceiling credential stuffing runs against.
RATE_LIMIT_AUTH_MAX_REQUESTS=10
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=1
SESSION_TTL_HOURS=720

# --- Blockchain RPC (failover-managed; no single provider is authoritative) ---
RPC_ETHEREUM_MAINNET=
RPC_ETHEREUM_SEPOLIA=
RPC_BASE_MAINNET=
RPC_BASE_SEPOLIA=

# --- ERC-4337 (smart accounts) ---
BUNDLER_RPC_URL=
PAYMASTER_RPC_URL=

# --- Metals provider / issuer (the primary execution rail) ---
METALS_PROVIDER_API_KEY=
METALS_PROVIDER_API_URL=
METALS_PROVIDER_SANDBOX=true

# --- Fiat on-ramp (KYC + card / bank rails are provider-handled) ---
ONRAMP_PROVIDER_API_KEY=
ONRAMP_PROVIDER_SANDBOX=true

# --- Persona (identity verification + watchlist screening) ---
# Both or neither: the config refuses a half-configured Persona at boot.
# Unset in development and test — the fake provider answers there, and the
# fiat gate fails closed on "screening unavailable" wherever no vendor can
# be reached. Values here are names only; secrets live in the environment.
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
# Inquiry template to verify against (verified: create-an-inquiry requires
# one of template-id / inquiry-template-id / inquiry-template-version-id).
PERSONA_TEMPLATE_ID=
#PERSONA_BASE_URL=https://api.withpersona.com/api/v1

# --- Market data ---
PRICE_FEED_API_KEY=
METAL_SPOT_FEED_API_KEY=

# --- First admin (read only by the dev seed) ---
# Set both to bootstrap an admin on `pnpm seed`. Leave unset otherwise.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
