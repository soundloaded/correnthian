{
  "name": "@correnthian/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Correnthian operations console (Nexora template shell, rewired to live API)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@correnthian/api-client": "workspace:*",
    "@correnthian/contracts": "workspace:*",
    "@correnthian/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/router-plugin": "1.168.45",
    "date-fns": "4.4.0",
    "react-day-picker": "10.0.2",
    "recharts": "3.8.0",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "typescript": "^6",
    "vite": "8.3.4",
    "vitest": "^2.1.9"
  }
}
