{
  "name": "@correnthian/blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Chain engines - EVM, Bitcoin, Solana - behind BlockchainAdapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.package.json"
  },
  "dependencies": {
    "@correnthian/types": "workspace:*",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
